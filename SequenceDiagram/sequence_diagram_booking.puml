@startuml CreateReservation

actor A_Customer
participant GameStore
participant P_Customer
participant Room
participant Reservation
participant Log

A_Customer -> GameStore : create_reservation(customer_id, room_id, start_time, end_time)
activate GameStore

loop search customer by id
	GameStore -> P_Customer : get_customer_by_id(customer_id)
	P_Customer --> GameStore : customer / None
end

alt invalid customer
	GameStore -> A_Customer : "Invalid User"

else valid customer
	GameStore -> P_Customer : check_time_availability(start_time, end_time)

	alt invalid time frame
		GameStore -> A_Customer : "Invalid Time Frame"

	else customer available

		loop search room by id
			GameStore -> Room : get_room_by_id(room_id)
			Room --> GameStore : room / None
		end

		alt room not found
			GameStore -> A_Customer : "No Room this ID"

		else room found
			GameStore -> Room : create_reservation(make_id("RE"), customer, start_time, end_time)
			activate Room

			Room -> Reservation : create reservation
			activate Reservation
			Reservation -> Reservation : initialize reservation data
			Reservation --> Room : reservation / None
			deactivate Reservation

			alt reservation creation failed
				Room --> GameStore : None
				deactivate Room
				GameStore -> A_Customer : "Invalid Time Frame"

			else reservation created
				Room --> GameStore : reservation
				deactivate Room

				GameStore -> P_Customer : add_reservation(reservation)

				GameStore -> Log : create_customer_logs(customer, CREATE_RESERVATION)
				activate Log
				Log --> GameStore : log created
				deactivate Log

				GameStore --> A_Customer : reservation.id
			end
		end
	end
end

deactivate GameStore
@enduml