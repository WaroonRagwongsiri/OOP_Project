@startuml Customer
actor Customer
participant GameStore
participant Room

Customer -> GameStore : create_reservation(customer_id, room_id, start_time, end_time)
activate GameStore

GameStore -> GameStore : get_customer_by_id(customer_id)

alt customer not found
	GameStore --> Customer : ValueError("Invalid User")

else customer found
	GameStore -> Customer : check_time_availability(start_time, end_time)

	alt invalid time frame
		GameStore --> Customer : ValueError("Invalid Time Frame")

	else time available
		GameStore -> GameStore : get_room_by_id(room_id)

		alt room not found
			GameStore --> Customer : ValueError("No Room this ID")

		else room found
			GameStore -> Room : create_reservation(make_id("RE"), customer, start_time, end_time)
			activate Room
			Room --> GameStore : reservation / None
			deactivate Room

			alt reservation is None
				GameStore --> Customer : ValueError("Invalid Time Frame")

			else reservation created
				GameStore -> Customer : add_reservation(reservation)
				GameStore -> GameStore : create_customer_logs(customer, CREATE_RESERVATION)
				GameStore --> Customer : reservation.id
			end
		end
	end
end

deactivate GameStore
@enduml