@startuml Create Coupon Sequence Diagram

actor Manager as A_Manager

A_Manager -> GameStore: create_coupon(manager_id, customer_id, minimum_amount, discount_amount, expire_date)
activate A_Manager

activate GameStore
loop get manager by id
	GameStore -> Manager: get_manager_by_id(manager_id)
	activate Manager
	Manager -> GameStore: Manager
	deactivate Manager
end

loop get customer by id
	GameStore -> Customer: get_customer_by_id(customer_id)
	activate Customer
	Customer -> GameStore: Customer
	deactivate Customer
end

GameStore -> Coupon: Coupon(customer, minimum_amount, discount_amount, expire_date)
activate Coupon
Coupon -> GameStore: Coupon
deactivate Coupon

GameStore -> Customer: add_coupon(coupon)
activate Customer
Customer -> GameStore:
deactivate Customer

GameStore -> ManagerLogs: create_manager_logs(manager, ManagerAction.CREATE_COUPON, coupon)
activate ManagerLogs
ManagerLogs -> GameStore: ManagerLogs
deactivate ManagerLogs

GameStore -> GameStore: add_manager_log(log)

GameStore -> A_Manager: Coupon
deactivate GameStore

deactivate A_Manager

@enduml
